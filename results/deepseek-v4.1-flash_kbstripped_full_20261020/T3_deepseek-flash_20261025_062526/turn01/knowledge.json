  "selected": [
    {
      "id": "common-comparison-mask",
      "severity": "must",
      "path": "methods/common-comparison-mask.md",
      "sha256": "bbb98200f52b4a692ce097704b8c438179a795a44bec6b856c03cf31931af4ea",
      "reason": "The comparison of model SST against WOA23 must be made on a single common mask over all compared fields and models, and WOA23's land-sea mask must only be used for comparisons that include WOA23.",
      "status": "condensed",
      "notes": [
        "Regrid all fields to the WOA23 1° grid, build one mask with `build_comparison_mask` and apply it with `.where(mask)` to every field before any metric; WOA23 is the reference here, so the default `ocean_only=True` is the right choice.",
        "Report the cell counts the mask records, and quote the shared-sample means `mean_data`/`mean_reference` returned by `compute_difference_metrics` together with the bias, not means computed separately over different cells."
      ]
    },
    {
      "id": "omip-weighted-means-and-integrals",
      "severity": "should",
      "path": "methods/omip-weighted-means-and-integrals.md",
      "sha256": "89de52676ae54db8f5897bc77a08c78de3f776696db0020935a38b790c302cbe",
      "reason": "Global mean SST must be area-weighted over each model's native ocean grid using areacello, not an unweighted average over grid cells.",
      "status": "condensed",
      "notes": [
        "Global mean SST is area-weighted over the top level: Σ `tos`·`areacello` / Σ `areacello` over valid cells with NaN-aware weights; `compute_basic_stat(op='area_weighted_mean')`; plain `mean()` over (y, x) is wrong.",
        "`compute_difference_metrics` weights by area by default; `analyze_correlation` needs `weighting='area'` for the spatial pattern correlation."
      ]
    },
    {
      "id": "omip-native-grid-vs-regridded",
      "severity": "should",
      "path": "methods/omip-native-grid-vs-regridded.md",
      "sha256": "8ff046ffbadc5794fcd2f8fe93d3bb947c736dec650aa3a3cd6e2412b7da8e68",
      "reason": "Native-grid means and conservation should be computed on the models' own grids, with regridding used only for maps and pattern comparisons such as those against WOA23.",
      "status": "condensed",
      "notes": [
        "Take each global mean on the model's own grid with its own cell areas; regrid to the 1° grid only for the cell-by-cell comparison, using method 'conservative', and state that method wherever the RMSE or pattern correlation is quoted."
      ]
    },
    {
      "id": "cmip6-grid-labels",
      "severity": "should",
      "path": "datasets/cmip6-grid-labels.md",
      "sha256": "e349f9e305621b6c10b35cccd0490da521cc7e3ba08bfb53890479f81024d117",
      "reason": "CESM2 and MPI-ESM1-2-LR are native-grid gn while GFDL-ESM4 is gr, which affects masks and which operations are exact when comparing on the WOA23 1-degree grid.",
      "status": "condensed",
      "notes": [
        "GFDL-ESM4 is labelled `gr`: its values are already remapped to 180,360 1° (conserve_order1), so its \"native-grid\" mean is a mean on that 1° archive grid with the regridded land–sea mask, and budgets are only approximately conservative."
      ]
    },
    {
      "id": "cmip6-static-grid-fields",
      "severity": "should",
      "path": "concepts/cmip6-static-grid-fields.md",
      "sha256": "2ad0548ca0993fa57d8f1fad27a267dcf9c0e1d007a74343d4bbdbf5b4f1ca17",
      "reason": "areacello is the tracer-cell horizontal area needed to form the requested global mean over each model's native ocean grid.",
      "status": "condensed",
      "notes": [
        "Use each model's published `areacello` as the area weight (origin recorded in `attrs['area_source']`) and state the total ocean area each mean was taken over rather than rescaling one model to match another."
      ]
    },
    {
      "id": "cmip6-tos-bulk-top-cell",
      "severity": "should",
      "path": "concepts/cmip6-tos-bulk-top-cell.md",
      "sha256": "4acdeba0f49784d4435dbc4eed34ca9777254313daa951641759fa02df24cf64",
      "reason": "tos is upper-boundary bulk potential temperature rather than a skin temperature, so the SST climatology and bias must be interpreted with that definition.",
      "status": "condensed",
      "notes": [
        "`tos` is the bulk temperature of the top model cell including water under sea ice; under-ice cells near freezing are valid, not missing, so a global mean includes polar values near −1.8 °C — keep the ocean masks consistent if WOA23 masks sea ice."
      ]
    },
    {
      "id": "missing-values-and-land-cells",
      "severity": "should",
      "path": "pitfalls/missing-values-and-land-cells.md",
      "sha256": "f576244f13dde06fed1777eaa9721c68844f61758f66fac704b44f1551e90df2",
      "reason": "CMIP6 land and below-sea-floor cells are marked with 1e20 and must be CF-masked before any mean, bias, RMSE or correlation is computed.",
      "status": "condensed",
      "notes": [
        "xarray decodes 1e20 to NaN; build each field's valid mask from the field itself (masks differ between variables), and use NaN-aware reductions whose weights are masked to the same cells."
      ]
    },
    {
      "id": "monthly-means-are-time-averages",
      "severity": "must",
      "path": "pitfalls/monthly-means-are-time-averages.md",
      "sha256": "df6b5c23460f88f1522e5c6a665e1efbb8322c3ae876c885530f3019aa284ee0",
      "reason": "The monthly CMIP6 tos values are time averages, so the 1971-2000 climatology must be built from the monthly means by appropriate time averaging rather than from instantaneous snapshots.",
      "status": "condensed",
      "notes": [
        "Averaging the 1971–2000 monthly `tos` to a climatology needs day weights in the model's own calendar: `temporal_aggregate(freq='mean')`; `compute_basic_stat(op='mean', dim='time')` gives every month equal weight and is not a time average."
      ]
    }
