  "selected": [
    {
      "id": "anomaly-baselines-and-climate-indices",
      "severity": "must",
      "path": "methods/anomaly-baselines-and-climate-indices.md",
      "sha256": "e0afb5c187aca1e075f9549153b1e896320bb0539544f66d3293fab4b4b77c92",
      "reason": "The Nino 3.4 index is an anomaly from each source's own 1950–2014 monthly climatology, so the baseline period must be applied identically to all four sources and the ENSO/index conventions govern how amplitude is defined.",
      "status": "condensed",
      "notes": [
        "Compute each Nino 3.4 index as the area-mean `tos` anomaly over 5S-5N, 170W-120W relative to that source's **own** 1950-2014 monthly climatology (each calendar month's multi-year mean); never subtract an observed/WOA climatology from model output, and group anomalies by calendar month for the 12 seasonal standard deviations.",
        "State the climatology and baseline (1950-2014) with every index; count exceedances as individual months with |anomaly| strictly > 1.0 °C, not persistence-defined events (`min_duration`)."
      ]
    },
    {
      "id": "omip-weighted-means-and-integrals",
      "severity": "should",
      "path": "methods/omip-weighted-means-and-integrals.md",
      "sha256": "89de52676ae54db8f5897bc77a08c78de3f776696db0020935a38b790c302cbe",
      "reason": "The 5S–5N, 170W–120W average must be area-weighted over each source's own cell areas rather than a simple grid-point mean, and every cell in the region is used with no subsampling.",
      "status": "condensed",
      "notes": [
        "The regional index is an area-weighted mean: Σ(`tos`·`areacello`)/Σ`areacello` over valid ocean cells in the box, using each model's published `areacello` and ERSSTv5's own cell areas; an unweighted mean over (y,x) on a curvilinear grid is wrong (`compute_basic_stat(op='area_weighted_mean')`).",
        "Restrict weights to the same valid cells as `tos` (NaN-aware), otherwise land/missing cells enter the denominator; the standard deviation over the 780 monthly index values is unweighted in time with ddof=0."
      ]
    },
    {
      "id": "cmip6-grid-labels",
      "severity": "should",
      "path": "datasets/cmip6-grid-labels.md",
      "sha256": "e349f9e305621b6c10b35cccd0490da521cc7e3ba08bfb53890479f81024d117",
      "reason": "CESM2 and MPI-ESM1-2-LR are native gn grids while GFDL-ESM4 is gr (already regridded to 1°), so \"native grid with published cell areas\" means different things for the three models and affects the region mask and weighting.",
      "status": "condensed",
      "notes": [
        "GFDL-ESM4 is `grid_label='gr'`: its archive is already remapped to 180×360 1°; treat that 1° grid, its regridded land–sea mask and its cell areas as its \"native\" grid for the index.",
        "Resolution differs (CESM2 ~100 km vs MPI-ESM1-2-LR ~250 km); features narrower than the coarse grid are not comparable in amplitude, so state this when comparing model amplitudes."
      ]
    },
    {
      "id": "cmip6-tos-bulk-top-cell",
      "severity": "should",
      "path": "concepts/cmip6-tos-bulk-top-cell.md",
      "sha256": "4acdeba0f49784d4435dbc4eed34ca9777254313daa951641759fa02df24cf64",
      "reason": "tos is the top-cell bulk temperature under sea ice and ice shelves, not a skin temperature, which must be stated when comparing its variability amplitude with ERSSTv5.",
      "status": "condensed",
      "notes": [
        "Use archived `tos` directly (available for historical); it is the bulk temperature of the top model cell, and top-cell thickness differs (CESM2 0–10 m, GFDL-ESM4 0–2 m, MPI-ESM1-2-LR 0–12 m), so part of any amplitude difference may be definitional; no need to substitute level 1 of `thetao`.",
        "A model ENSO index must be its anomaly from its own climatology; subtracting an observed climatology puts the model's mean-state bias into the index."
      ]
    },
    {
      "id": "monthly-means-are-time-averages",
      "severity": "must",
      "path": "pitfalls/monthly-means-are-time-averages.md",
      "sha256": "df6b5c23460f88f1522e5c6a665e1efbb8322c3ae876c885530f3019aa284ee0",
      "reason": "The standard deviations and monthly breakdowns are second-order statistics computed offline from monthly means, which is not the same as the variance of the underlying time series.",
      "status": "condensed",
      "notes": [
        "Build each monthly climatology as the plain mean of that calendar month's values over 1950-2014 (no day weights); `compute_anomaly_vs_own_climatology` does this and records climatology and baseline in the result attrs.",
        "The index is a linear area mean followed by a subtraction, so f(monthly mean) nonlinearity does not reorder operations here; the 780-month standard deviation is over monthly index values with ddof=0."
      ]
    },
    {
      "id": "common-comparison-mask",
      "severity": "must",
      "path": "methods/common-comparison-mask.md",
      "sha256": "bbb98200f52b4a692ce097704b8c438179a795a44bec6b856c03cf31931af4ea",
      "reason": "The model-versus-ERSSTv5 amplitude biases and the model ranking are comparisons that should be stated against a consistent definition of the region/coverage.",
      "status": "not_applicable",
      "not_applicable_reason": "the question compares regional-mean time-series indices, not cell-by-cell fields on a common grid; each index is computed on its own source's grid."
    },
    {
      "id": "cmip6-experiments-historical-ssp245",
      "severity": "should",
      "path": "datasets/cmip6-experiments-historical-ssp245.md",
      "sha256": "be5515ae7b8c8826c4e329bddcd5cbadc8e3e000292b7f6e83e1537af36a990c",
      "reason": "The historical runs are coupled with free internal variability and are not year-synchronised with the observed years, so model-versus-ERSSTv5 amplitude differences include internal variability, not only forced bias.",
      "status": "condensed",
      "notes": [
        "Only the historical run is used; coupled runs have their own internal variability, so compare amplitude statistics (std, seasonal cycle, exceedance counts), not individual years or event timing against ERSSTv5.",
        "One member per model cannot separate forced amplitude change from internal variability; state this caveat when interpreting model-to-model amplitude differences."
      ]
    },
    {
      "id": "omip-native-grid-vs-regridded",
      "severity": "should",
      "path": "methods/omip-native-grid-vs-regridded.md",
      "sha256": "8ff046ffbadc5794fcd2f8fe93d3bb947c736dec650aa3a3cd6e2412b7da8e68",
      "reason": "Diagnostics should be computed on each model's own grid where possible, since GFDL-ESM4's regridding changes its land-sea mask and thus the cells entering the Nino 3.4 average.",
      "status": "condensed",
      "notes": [
        "Compute each source's Nino 3.4 regional mean on its own grid with its own cell areas; do not regrid `tos` before forming the index, since regridding replaces cell areas and changes the mean.",
        "Say which grid each number came from; comparing scalar indices across sources does not require regridding."
      ]
    }
